/// Data processing helpers: dataset cleaning, normalization, CSV parsing,
/// and descriptive statistics. Import: `import std.data.*;`

/// Trims leading/trailing ASCII spaces.
fn trim(string s) -> string {
    let n = str_len(s);
    mut lo = 0;
    while (lo < n && str_index(s, lo) == 32) { lo = lo + 1; }
    mut hi = n - 1;
    while (hi > lo && str_index(s, hi) == 32) { hi = hi - 1; }
    if (hi < lo) { return ""; }
    return str_slice(s, lo, hi + 1);
}

/// Converts a string to lowercase ASCII. Non-letters are unchanged.
fn lower(string s) -> string {
    let n = str_len(s);
    mut out = "";
    mut i = 0;
    while (i < n) {
        let c = str_index(s, i);
        mut ch = c;
        if (c >= 65 && c <= 90) { ch = c + 32; }
        out = str_concat(out, char_to_str(ch));
        i = i + 1;
    }
    return out;
}

/// Converts a string to uppercase ASCII.
fn upper(string s) -> string {
    let n = str_len(s);
    mut out = "";
    mut i = 0;
    while (i < n) {
        let c = str_index(s, i);
        mut ch = c;
        if (c >= 97 && c <= 122) { ch = c - 32; }
        out = str_concat(out, char_to_str(ch));
        i = i + 1;
    }
    return out;
}

/// Removes all non-alphanumeric/whitespace characters from s (basic cleaning).
fn clean(string s) -> string {
    let n = str_len(s);
    mut out = "";
    mut i = 0;
    while (i < n) {
        let c = str_index(s, i);
        mut ok = 1;
        if (c >= 48 && c <= 57)  { ok = 1; }   // digit
        else if (c >= 65 && c <= 90)  { ok = 1; } // A-Z
        else if (c >= 97 && c <= 122) { ok = 1; } // a-z
        else if (c == 32) { ok = 1; }
        else { ok = 0; }
        if (ok == 1) { out = str_concat(out, char_to_str(c)); }
        i = i + 1;
    }
    return out;
}

/// Collapses runs of whitespace/spaces into a single space and trims the ends.
fn normalize_ws(string s) -> string {
    let n = str_len(s);
    mut out = "";
    mut i = 0;
    mut in_ws = 0;
    while (i < n) {
        let c = str_index(s, i);
        if (c == 32 || c == 9 || c == 10) {
            if (in_ws == 0) { in_ws = 1; }
        } else {
            if (in_ws == 1) { if (str_len(out) > 0) { out = str_concat(out, " "); } in_ws = 0; }
            out = str_concat(out, char_to_str(c));
        }
        i = i + 1;
    }
    return out;
}

/// Splits s on a single-character delimiter. Returns [string].
fn split_char(string s, int64 delim) -> [string] {
    mut parts = [""];
    let n = str_len(s);
    mut cur = "";
    mut i = 0;
    while (i < n) {
        let c = str_index(s, i);
        if (c == delim) {
            parts.push(cur);
            cur = "";
        } else {
            cur = str_concat(cur, char_to_str(c));
        }
        i = i + 1;
    }
    parts.push(cur);
    return parts;
}

/// Splits s on comma (CSV-style). Quoted fields and spaces are returned as-is.
fn split_csv(string s) -> [string] {
    let n = str_len(s);
    mut parts = [""];
    mut cur = "";
    mut i = 0;
    mut in_q = 0;
    while (i < n) {
        let c = str_index(s, i);
        if (c == 34) {  // '"'
            if (in_q == 1) { in_q = 0; } else { in_q = 1; }
        } else if (c == 44 && in_q == 0) {  // ',' outside quotes
            parts.push(cur);
            cur = "";
        } else {
            cur = str_concat(cur, char_to_str(c));
        }
        i = i + 1;
    }
    parts.push(cur);
    return parts;
}

/// Parses a CSV text (newline-separated rows) into a 2D [string] array.
/// Each inner array is one row of fields.
fn parse_csv(string csv) -> [ [string] ] {
    let rows = split_char(csv, 10);      // split on '\n'
    mut table = [ [""] ];
    mut r = 1;
    while (r < len(rows)) {
        let line = rows[r];
        if (str_len(trim(line)) > 0) {
            table.push(split_csv(trim(line)));
        }
        r = r + 1;
    }
    return table;
}

/// Returns the arithmetic mean of a [float64] array (0.0 if empty).
fn mean_f([float64] a) -> float64 {
    let n = len(a) - 1;
    if (n <= 0) { return 0.0; }
    mut total = 0.0;
    mut i = 1;
    while (i < n + 1) {
        total = total + a[i];
        i = i + 1;
    }
    return total / int64_to_float64(n);
}

/// Returns the standard deviation (population, n) of a [float64] array.
fn stdev_f([float64] a) -> float64 {
    let n = len(a) - 1;
    if (n <= 1) { return 0.0; }
    let m = mean_f(a);
    mut ss = 0.0;
    mut i = 1;
    while (i < n + 1) {
        let d = a[i] - m;
        ss = ss + d * d;
        i = i + 1;
    }
    return sqrt(ss / int64_to_float64(n));
}

/// Returns the minimum of a [float64] array (0.0 if empty).
fn min_f([float64] a) -> float64 {
    let n = len(a) - 1;
    if (n <= 0) { return 0.0; }
    mut best = a[1];
    mut i = 2;
    while (i < n + 1) {
        if (a[i] < best) { best = a[i]; }
        i = i + 1;
    }
    return best;
}

/// Returns the maximum of a [float64] array (0.0 if empty).
fn max_f([float64] a) -> float64 {
    let n = len(a) - 1;
    if (n <= 0) { return 0.0; }
    mut best = a[1];
    mut i = 2;
    while (i < n + 1) {
        if (a[i] > best) { best = a[i]; }
        i = i + 1;
    }
    return best;
}

/// Converts a [float64] array to a text line of comma-separated values.
fn to_csv_line([float64] a) -> string {
    let n = len(a) - 1;
    mut out = "";
    mut i = 1;
    while (i < n + 1) {
        out = str_concat(out, float64_to_str(a[i]));
        if (i < n) { out = str_concat(out, ","); }
        i = i + 1;
    }
    return out;
}
