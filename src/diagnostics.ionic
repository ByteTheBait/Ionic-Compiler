// ── Token descriptions (for human-readable parse errors) ─────────────────────
fn tok_desc(int64 kind) -> string {
    if (kind == TOK_SEMI)     { return "';'"; }
    if (kind == TOK_LPAREN)   { return "'('"; }
    if (kind == TOK_RPAREN)   { return "')'"; }
    if (kind == TOK_LBRACE)   { return "'{'"; }
    if (kind == TOK_RBRACE)   { return "'}'"; }
    if (kind == TOK_LBRACKET) { return "'['"; }
    if (kind == TOK_RBRACKET) { return "']'"; }
    if (kind == TOK_COMMA)    { return "','"; }
    if (kind == TOK_COLON)    { return "':'"; }
    if (kind == TOK_EQ)       { return "'='"; }
    if (kind == TOK_ARROW)    { return "'->'"; }
    if (kind == TOK_DOT_DOT)  { return "'..'"; }
    if (kind == TOK_IN)       { return "'in'"; }
    if (kind == TOK_IDENT)    { return "identifier"; }
    if (kind == TOK_PLUS_EQ)  { return "'+='"; }
    if (kind == TOK_MINUS_EQ) { return "'-='"; }
    if (kind == TOK_STAR_EQ)  { return "'*='"; }
    if (kind == TOK_SLASH_EQ) { return "'/='"; }
    if (kind == TOK_BAD_CHAR) { return "bad-char"; }
    return str_concat("token#", int64_to_str(kind));
}

// ── ANSI color support ────────────────────────────────────────────────────────
// Set g_color_enabled before any print_span / sc_hint_* call. Defaults to 1
// for an interactive shell; auto-disabled when NO_COLOR is set or TERM=dumb
// so CI logs and pipes stay clean. Plain text otherwise.

mut g_color_enabled = 1;

// ESC byte (ASCII 27). String literals in Ionic only support \n, \t, \" and \\
// — no \x1b — so we build the escape sequences via char_to_str(27).
let ANSI_ESC = char_to_str(27);

let ANSI_RESET       = str_concat(ANSI_ESC, "[0m");
let ANSI_BOLD_RED    = str_concat(ANSI_ESC, "[1;31m");
let ANSI_BOLD_YELLOW = str_concat(ANSI_ESC, "[1;33m");
let ANSI_BOLD_GREEN  = str_concat(ANSI_ESC, "[1;32m");
let ANSI_BOLD_CYAN   = str_concat(ANSI_ESC, "[1;36m");
let ANSI_CYAN        = str_concat(ANSI_ESC, "[36m");
let ANSI_DIM         = str_concat(ANSI_ESC, "[2m");
let ANSI_BOLD        = str_concat(ANSI_ESC, "[1m");

// Wrap `s` with an ANSI prefix/suffix if colors are enabled, else return `s` unchanged.
fn color_wrap(string prefix, string s) -> string {
    if (g_color_enabled == 0) { return s; }
    return str_concat(prefix, str_concat(s, ANSI_RESET));
}

// Auto-detect color support: disable if NO_COLOR is set, or TERM=dumb/empty.
// Called once from print_span; idempotent.
fn color_autodetect() -> int64 {
    let no_color = getenv("NO_COLOR");
    if (str_len(no_color) > 0) { g_color_enabled = 0; return 0; }
    let term = getenv("TERM");
    if (str_eq(term, "dumb")) { g_color_enabled = 0; return 0; }
    if (str_eq(term, ""))    { g_color_enabled = 0; return 0; }
    return 0;
}

// ── Diagnostic utilities ─────────────────────────────────────────────────────
// Set g_source before calling print_span so it can print the source line.
mut g_source = "";

// Source path of the file currently being compiled. Set by main.ionic to
// the argv[1] argument (or "<source>" for stdin). Used by print_jump_hint
// to render the clickable file:line:col link that editors like VSCode,
// iTerm2, and Neovim auto-detect.
mut g_source_path = "<source>";

// Build the clickable "path:line:col" string for the given location.
// When colors are enabled, wraps the path in cyan+underline so it pops.
// Otherwise returns plain text — which is what editors parse.
fn print_jump_hint(int64 line, int64 col) -> int64 {
    let link = str_concat(g_source_path, str_concat(":",
                  str_concat(int64_to_str(line), str_concat(":",
                  str_concat(int64_to_str(col), "")))));
    // Plain text path is always emitted so editors can extract it; this is
    // what VSCode/iTerm2/Neovim auto-detect as a clickable link.
    if (g_color_enabled == 1) {
        let underline_cyan = str_concat(ANSI_ESC, "[4;36m");
        println(str_concat("    at ",
               str_concat(underline_cyan,
               str_concat(link, ANSI_RESET))));
    } else {
        println(str_concat("    at ", link));
    }
    return 0;
}

// After printing all errors, if $EDITOR or $VISUAL is set, print a one-liner
// telling the user how to re-run with their editor. Cheap DX win.
// Guarded by a flag so it only fires once even if called multiple times
// (e.g. parser errors AND semantic errors both calling exit(1)).
mut g_editor_hint_shown = 0;

fn print_editor_hint() -> int64 {
    if (g_editor_hint_shown == 1) { return 0; }
    let editor = getenv("VISUAL");
    if (str_eq(editor, "")) { editor = getenv("EDITOR"); }
    if (str_eq(editor, "")) { return 0; }
    g_editor_hint_shown = 1;
    // Build the hint in 4 pieces (opening, path, parens+editor, closing)
    // to avoid a deep str_concat chain. ASCII only -- the lexer mangles
    // UTF-8 multi-byte chars (e.g. em-dash -> 0x14).
    let part1 = str_concat("    hint: re-run `", g_source_path);
    let part2 = str_concat(part1, "` in your editor (");
    let part3 = str_concat(part2, editor);
    let part4 = str_concat(str_concat(part3, ") -- click path:line:col above to jump."));
    println(part4);
    return 0;
}

// Enclosing function context (set by the semantic checker before descending
// into a function body). When nonzero, print_span prints a one-line dim
// header like "    in fn compute(int64 n) -> int64 {" above the source line
// so the user has a frame of reference for the caret position.
//
//   sc_ctx_fn_line      — line where the enclosing `fn` starts (1-based)
//   sc_ctx_fn_label     — the human-readable signature line, e.g.
//                          "fn compute(int64 n) -> int64 {"
//
// Set both to 0 / "" at top level (or when no enclosing fn is active).
mut sc_ctx_fn_line = 0;
mut sc_ctx_fn_label = "";

// Stack of (line, label) so nested function definitions (which the
// language allows via local fn) properly nest/restore the context.
// sc_ctx_fn_depth is the logical number of pushed frames; 0 = "no
// enclosing fn". The arrays store parents at their depth slot.
mut sc_ctx_fn_depth = 0;
mut sc_ctx_fn_line_stack = [0];
mut sc_ctx_fn_label_stack = [""];

// Save the current enclosing-fn context and push a new one. The new line
// is where the new fn header starts; the new label is its signature.
fn sc_ctx_push_fn(int64 line, string label) -> int64 {
    sc_ctx_fn_depth = sc_ctx_fn_depth + 1;
    // Grow the arrays if needed (push if past current capacity).
    if (sc_ctx_fn_depth >= len(sc_ctx_fn_line_stack)) {
        sc_ctx_fn_line_stack.push(sc_ctx_fn_line);
        sc_ctx_fn_label_stack.push(sc_ctx_fn_label);
    } else {
        sc_ctx_fn_line_stack[sc_ctx_fn_depth]  = sc_ctx_fn_line;
        sc_ctx_fn_label_stack[sc_ctx_fn_depth] = sc_ctx_fn_label;
    }
    sc_ctx_fn_line  = line;
    sc_ctx_fn_label = label;
    return 0;
}

// Pop back to the previous enclosing-fn context (one level up).
// Uses the sv_pop_frame pattern: just decrement the depth counter and
// restore from the array slot. Doesn't need array.pop() (which the
// runtime doesn't expose).
fn sc_ctx_pop_fn() -> int64 {
    if (sc_ctx_fn_depth <= 0) {
        sc_ctx_fn_line  = 0;
        sc_ctx_fn_label = "";
        return 0;
    }
    sc_ctx_fn_depth = sc_ctx_fn_depth - 1;
    let idx = sc_ctx_fn_depth;
    if (idx == 0) {
        // depth 0 means "no context" — the [0] sentinels are the defaults.
        sc_ctx_fn_line  = 0;
        sc_ctx_fn_label = "";
    } else {
        sc_ctx_fn_line  = sc_ctx_fn_line_stack[idx];
        sc_ctx_fn_label = sc_ctx_fn_label_stack[idx];
    }
    return 0;
}

// Return the byte offset of the start of line `line` (1-based) in src.
fn diag_line_start(string src, int64 line) -> int64 {
    mut cur = 1;
    mut i = 0;
    let n = str_len(src);
    while (i < n) {
        if (cur == line) { return i; }
        if (str_index(src, i) == CH_NL) { cur = cur + 1; }
        i = i + 1;
    }
    return i;
}

// Extract text of one line starting at byte offset `start` (stops at \n or end).
fn diag_extract_line(string src, int64 start) -> string {
    mut s = "";
    let n = str_len(src);
    mut i = start;
    while (i < n) {
        let c = str_index(src, i);
        if (c == CH_NL) { return s; }
        s = str_concat(s, char_to_str(c));
        i = i + 1;
    }
    return s;
}

// Build a string of `n` space characters.
fn diag_spaces(int64 n) -> string {
    mut s = "";
    mut i = 0;
    while (i < n) { s = str_concat(s, " "); i = i + 1; }
    return s;
}

// Print a caret diagnostic:
//   path:line:col:                      (clickable jump link)
//   [error] line:col: message
//       in fn foo() -> int64 {          (if error is inside a fn body)
//       source line text
//       ^
fn print_span(int64 line, int64 col, string msg) -> int64 {
    color_autodetect();
    // Emit the clickable jump link first so editors can pick it up even if
    // the user filters lines that contain "[error]" out of their buffer.
    print_jump_hint(line, col);
    // Layout: bold-red "[error] ", cyan "line:col:", reset, then message.
    let tag   = color_wrap(ANSI_BOLD_RED, "[error]");
    let loc   = color_wrap(ANSI_CYAN, str_concat(int64_to_str(line), str_concat(":", str_concat(int64_to_str(col), ":"))));
    println(str_concat(str_concat(tag, " "), str_concat(loc, str_concat(" ", msg))));
    if (str_len(g_source) > 0) {
        let lstart = diag_line_start(g_source, line);
        let text   = diag_extract_line(g_source, lstart);
        // Enclosing-context line: only show when we have a context AND the
        // error is below the function header (i.e. inside the body, not on
        // the header line itself which would be redundant with the caret).
        if (sc_ctx_fn_line > 0 && line > sc_ctx_fn_line && str_len(sc_ctx_fn_label) > 0) {
            let ctx = color_wrap(ANSI_DIM, str_concat("    in ", sc_ctx_fn_label));
            println(ctx);
        }
        // Source line: 4-space indent + bold-yellow text.
        println(str_concat("    ", color_wrap(ANSI_BOLD_YELLOW, text)));
        // Caret line: col is 1-based, indent is 4 chars → caret lands at column (col + 3).
        // (4 spaces of indent, then (col-1) spaces to align with the source character.)
        let spaces = diag_spaces(col + 3);
        println(str_concat(spaces, color_wrap(ANSI_BOLD_RED, "^")));
    }
    return 0;
}
