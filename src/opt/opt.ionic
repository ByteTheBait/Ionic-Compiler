// ── Optimizer: constant folding + algebraic simplification + dead code elim ──
//
// Single-pass bottom-up tree rewriter. Runs after semantic check, before codegen.
// Mutates the AST node arrays in-place; expression rewrites return new node indices.

// ─── Integer constant folding ─────────────────────────────────────────────────

fn opt_fold_int(int64 op, int64 lv, int64 rv) -> int64 {
    // Returns a new ND_INT node with the folded result, or 0 if cannot fold.
    if (op == OP_ADD)    { return new_node(ND_INT, "", lv + rv, 0, 0, 0); }
    if (op == OP_SUB)    { return new_node(ND_INT, "", lv - rv, 0, 0, 0); }
    if (op == OP_MUL)    { return new_node(ND_INT, "", lv * rv, 0, 0, 0); }
    if (op == OP_DIV)    { if (rv == 0) { return 0; } return new_node(ND_INT, "", lv / rv, 0, 0, 0); }
    if (op == OP_MOD)    { if (rv == 0) { return 0; } return new_node(ND_INT, "", lv % rv, 0, 0, 0); }
    if (op == OP_EQEQ)   { if (lv == rv) { return new_node(ND_INT, "", 1, 0, 0, 0); } return new_node(ND_INT, "", 0, 0, 0, 0); }
    if (op == OP_NEQ)    { if (lv != rv) { return new_node(ND_INT, "", 1, 0, 0, 0); } return new_node(ND_INT, "", 0, 0, 0, 0); }
    if (op == OP_LT)     { if (lv < rv)  { return new_node(ND_INT, "", 1, 0, 0, 0); } return new_node(ND_INT, "", 0, 0, 0, 0); }
    if (op == OP_GT)     { if (lv > rv)  { return new_node(ND_INT, "", 1, 0, 0, 0); } return new_node(ND_INT, "", 0, 0, 0, 0); }
    if (op == OP_LTEQ)   { if (lv <= rv) { return new_node(ND_INT, "", 1, 0, 0, 0); } return new_node(ND_INT, "", 0, 0, 0, 0); }
    if (op == OP_GTEQ)   { if (lv >= rv) { return new_node(ND_INT, "", 1, 0, 0, 0); } return new_node(ND_INT, "", 0, 0, 0, 0); }
    if (op == OP_AND)    { return new_node(ND_INT, "", lv & rv, 0, 0, 0); }
    if (op == OP_OR)     { return new_node(ND_INT, "", lv | rv, 0, 0, 0); }
    if (op == OP_BITAND) { return new_node(ND_INT, "", lv & rv, 0, 0, 0); }
    if (op == OP_BITOR)  { return new_node(ND_INT, "", lv | rv, 0, 0, 0); }
    if (op == OP_BITXOR) { return new_node(ND_INT, "", lv ^ rv, 0, 0, 0); }
    if (op == OP_SHL)    { return new_node(ND_INT, "", lv << rv, 0, 0, 0); }
    if (op == OP_SHR)    { return new_node(ND_INT, "", lv >> rv, 0, 0, 0); }
    return 0;
}

// ─── Float constant folding ───────────────────────────────────────────────────
// Floats are stored in ND_FLOAT nodes as their IEEE-754 bit pattern in nd_iv
// (the native codegen emits that value directly). Folding therefore computes the
// result bit pattern at compile time via runtime helpers and stores it in a new
// ND_FLOAT node. Mixed int/float operands are promoted to float first.
fn opt_fold_float(int64 op, int64 lbits, int64 rbits) -> int64 {
    if (op == OP_FADD) { return new_node(ND_FLOAT, "", fadd_bits(lbits, rbits), 0, 0, 0); }
    if (op == OP_FSUB) { return new_node(ND_FLOAT, "", fsub_bits(lbits, rbits), 0, 0, 0); }
    if (op == OP_FMUL) { return new_node(ND_FLOAT, "", fmul_bits(lbits, rbits), 0, 0, 0); }
    if (op == OP_FDIV) { return new_node(ND_FLOAT, "", fdiv_bits(lbits, rbits), 0, 0, 0); }
    return 0;
}

// Fold a builtin float function call when all args are constant floats.
// Returns a new ND_FLOAT node with the result bit pattern, or 0 if not foldable.
fn opt_fold_float_call(string callee, int64 head) -> int64 {
    // single-arg float builtins: sqrt, fabs, floor, ceil
    if (str_eq(callee, "sqrt") || str_eq(callee, "fabs") ||
        str_eq(callee, "floor") || str_eq(callee, "ceil")) {
        if (head == 0) { return 0; }
        if (nd_i3[head] != 0) { return 0; }   // must be exactly one arg
        let a = nd_i2[head];
        if (nd_kind[a] != ND_FLOAT) { return 0; }
        let bits = nd_iv[a];
        let r = opt_float_unop(callee, bits);
        if (r != 0) { return r; }
        return 0;
    }
    return 0;
}

// Compute a single-arg float builtin bit pattern at compile time.
fn opt_float_unop(string callee, int64 bits) -> int64 {
    mut rb = 0;
    if (str_eq(callee, "sqrt"))  { rb = sqrt_bits(bits); }
    if (str_eq(callee, "fabs"))  { rb = fabs_bits(bits); }
    if (str_eq(callee, "floor")) { rb = floor_bits(bits); }
    if (str_eq(callee, "ceil"))  { rb = ceil_bits(bits); }
    return new_node(ND_FLOAT, "", rb, 0, 0, 0);
}

// ─── Deep clone with loop-variable substitution (for loop unrolling) ─────────
// Returns a deep copy of `node` where every ND_IDENT named `var` is replaced by
// an ND_INT literal with value `val`. Used to flatten one iteration of a for
// loop whose bounds are compile-time integer constants. new_node appends to the
// global node arrays, so cloning is always safe.

fn opt_clone_node(int64 node) -> int64 {
    if (node == 0) { return 0; }
    let k = nd_kind[node];
    // Leaf nodes
    if (k == ND_INT)   { return new_node(ND_INT, "", nd_iv[node], 0, 0, 0); }
    if (k == ND_BOOL)  { return new_node(ND_BOOL, "", nd_iv[node], 0, 0, 0); }
    if (k == ND_STR)   { return new_node(ND_STR, nd_sv[node], nd_iv[node], 0, 0, 0); }
    if (k == ND_FLOAT) { return new_node(ND_FLOAT, nd_sv[node], nd_iv[node], 0, 0, 0); }

    // Unary / binary operators
    if (k == ND_UNOP) {
        return new_node(ND_UNOP, "", nd_iv[node], opt_clone_node(nd_i2[node]), 0, 0);
    }
    if (k == ND_BINOP) {
        return new_node(ND_BINOP, "", nd_iv[node], opt_clone_node(nd_i2[node]), opt_clone_node(nd_i3[node]), 0);
    }
    if (k == ND_INDEX) {
        return new_node(ND_INDEX, "", nd_iv[node], opt_clone_node(nd_i2[node]), opt_clone_node(nd_i3[node]), 0);
    }
    if (k == ND_FIELD_ACCESS) {
        return new_node(ND_FIELD_ACCESS, nd_sv[node], nd_iv[node], opt_clone_node(nd_i2[node]), 0, 0);
    }
    if (k == ND_CALL) {
        return new_node(ND_CALL, nd_sv[node], nd_iv[node], opt_clone_node(nd_i2[node]), 0, 0);
    }
    if (k == ND_METHOD_CALL) {
        return new_node(ND_METHOD_CALL, nd_sv[node], nd_iv[node], opt_clone_node(nd_i2[node]), opt_clone_node(nd_i3[node]), 0);
    }
    if (k == ND_ARRAY_LIT) {
        return new_node(ND_ARRAY_LIT, "", nd_iv[node], opt_clone_node(nd_i2[node]), 0, 0);
    }
    if (k == ND_STRUCT_LIT) {
        return new_node(ND_STRUCT_LIT, nd_sv[node], nd_iv[node], opt_clone_node(nd_i2[node]), 0, 0);
    }
    if (k == ND_FIELD_INIT) {
        return new_node(ND_FIELD_INIT, nd_sv[node], nd_iv[node], opt_clone_node(nd_i2[node]), 0, 0);
    }
    if (k == ND_TO_GPU) {
        return new_node(ND_TO_GPU, "", nd_iv[node], opt_clone_node(nd_i2[node]), 0, 0);
    }
    if (k == ND_TO_CPU) {
        return new_node(ND_TO_CPU, "", nd_iv[node], opt_clone_node(nd_i2[node]), 0, 0);
    }
    if (k == ND_IDENT) {
        return node;  // leave identifiers as-is (no variable renaming inside for body)
    }

    // Statement nodes
    if (k == ND_BLOCK) {
        return new_node(ND_BLOCK, "", 0, opt_clone_node(nd_i2[node]), 0, 0);
    }
    if (k == ND_LET) {
        return new_node(ND_LET, nd_sv[node], nd_iv[node], opt_clone_node(nd_i2[node]), opt_clone_node(nd_i3[node]), nd_i4[node]);
    }
    if (k == ND_ASSIGN) {
        return new_node(ND_ASSIGN, "", 0, opt_clone_node(nd_i2[node]), opt_clone_node(nd_i3[node]), 0);
    }
    if (k == ND_EXPR_STMT) {
        return new_node(ND_EXPR_STMT, "", 0, opt_clone_node(nd_i2[node]), 0, 0);
    }
    if (k == ND_RETURN) {
        return new_node(ND_RETURN, "", 0, opt_clone_node(nd_i2[node]), 0, 0);
    }
    if (k == ND_IF) {
        return new_node(ND_IF, "", 0, opt_clone_node(nd_i2[node]), opt_clone_node(nd_i3[node]), opt_clone_node(nd_i4[node]));
    }
    if (k == ND_WHILE) {
        return new_node(ND_WHILE, "", 0, opt_clone_node(nd_i2[node]), opt_clone_node(nd_i3[node]), 0);
    }
    if (k == ND_FOR) {
        return new_node(ND_FOR, nd_sv[node], nd_iv[node], opt_clone_node(nd_i2[node]), opt_clone_node(nd_i3[node]), opt_clone_node(nd_i4[node]));
    }
    if (k == ND_GPU_BLOCK) {
        return new_node(ND_GPU_BLOCK, "", 0, opt_clone_node(nd_i2[node]), 0, 0);
    }
    if (k == ND_BREAK || k == ND_CONTINUE || k == ND_IMPORT_STMT) {
        return new_node(k, "", 0, 0, 0, 0);
    }

    // CONS-list node — walk chain preserving structure
    if (k == ND_CONS) {
        return new_node(ND_CONS, "", 0, opt_clone_node(nd_i2[node]), opt_clone_node(nd_i3[node]), 0);
    }

    return node;
}

// Replace ND_IDENT(var) with ND_INT(val) throughout an already-cloned subtree.
fn opt_subst_var(int64 node, string var, int64 val) -> int64 {
    if (node == 0) { return 0; }
    let k = nd_kind[node];
    if (k == ND_IDENT && str_eq(nd_sv[node], var)) {
        return new_node(ND_INT, "", val, 0, 0, 0);
    }
    if (k == ND_BINOP) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
        nd_i3[node] = opt_subst_var(nd_i3[node], var, val);
    } else if (k == ND_UNOP) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
    } else if (k == ND_CALL) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
    } else if (k == ND_METHOD_CALL) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
        nd_i3[node] = opt_subst_var(nd_i3[node], var, val);
    } else if (k == ND_INDEX) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
        nd_i3[node] = opt_subst_var(nd_i3[node], var, val);
    } else if (k == ND_FIELD_ACCESS) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
    } else if (k == ND_ARRAY_LIT) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
    } else if (k == ND_STRUCT_LIT) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
    } else if (k == ND_FIELD_INIT) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
    } else if (k == ND_TO_GPU || k == ND_TO_CPU) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
    } else if (k == ND_RETURN) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
    } else if (k == ND_EXPR_STMT) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
    } else if (k == ND_LET) {
        nd_i3[node] = opt_subst_var(nd_i3[node], var, val);
    } else if (k == ND_ASSIGN) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
        nd_i3[node] = opt_subst_var(nd_i3[node], var, val);
    } else if (k == ND_IF) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
        nd_i3[node] = opt_subst_var(nd_i3[node], var, val);
        nd_i4[node] = opt_subst_var(nd_i4[node], var, val);
    } else if (k == ND_FOR) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
        nd_i3[node] = opt_subst_var(nd_i3[node], var, val);
        nd_i4[node] = opt_subst_var(nd_i4[node], var, val);
    } else if (k == ND_WHILE) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
        nd_i3[node] = opt_subst_var(nd_i3[node], var, val);
    } else if (k == ND_GPU_BLOCK) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
    } else if (k == ND_BLOCK) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
    } else if (k == ND_CONS) {
        nd_i2[node] = opt_subst_var(nd_i2[node], var, val);
        nd_i3[node] = opt_subst_var(nd_i3[node], var, val);
    }
    return node;
}

// ─── Statement-level helpers ────────────────────────────────────────────────────
// Recursively check a statement subtree for break/continue (unrolling is only
// safe when none are present).
fn opt_stmt_has_control(int64 node) -> bool {
    if (node == 0) { return false; }
    let k = nd_kind[node];
    if (k == ND_BREAK || k == ND_CONTINUE) { return true; }
    if (k == ND_BLOCK) { return opt_stmts_has_control(nd_i2[node]); }
    if (k == ND_IF) {
        if (opt_stmt_has_control(nd_i2[node])) { return true; }
        if (opt_stmt_has_control(nd_i3[node])) { return true; }
        if (opt_stmt_has_control(nd_i4[node])) { return true; }
    }
    if (k == ND_WHILE) {
        if (opt_stmt_has_control(nd_i2[node])) { return true; }
        if (opt_stmt_has_control(nd_i3[node])) { return true; }
    }
    if (k == ND_FOR) {
        if (opt_stmt_has_control(nd_i4[node])) { return true; }
    }
    if (k == ND_GPU_BLOCK) {
        if (opt_stmt_has_control(nd_i2[node])) { return true; }
    }
    return false;
}

fn opt_stmts_has_control(int64 list) -> bool {
    mut c = list;
    while (c != 0) {
        if (opt_stmt_has_control(nd_i2[c])) { return true; }
        c = nd_i3[c];
    }
    return false;
}

// ─── Function inlining (leaf functions) ───────────────────────────────────────
// Inline "leaf" pure functions: bodies that are exactly a single
// `return <expr>` where `<expr>` contains no function calls and no
// control flow. We rewrite the call site to the cloned return expression
// with each parameter substituted by its (already-optimized) argument.
// This avoids recursion/aliasing hazards and the need to lower multi-statement
// bodies with jump-to-end lowering.

mut inline_names    = [""];
mut inline_bodies   = [0];   // ND_RETURN node's expression (the pure body expr)
mut inline_params   = [0];   // ND_PARAM list (for param names)
mut inline_count    = 0;

// Does `node` contain any ND_CALL or ND_METHOD_CALL? (Guards against recursion
// and side-effecting calls inside an inlined body.)
fn opt_has_call(int64 node) -> bool {
    if (node == 0) { return false; }
    let k = nd_kind[node];
    if (k == ND_CALL || k == ND_METHOD_CALL) { return true; }
    if (k == ND_BINOP) {
        if (opt_has_call(nd_i2[node])) { return true; }
        if (opt_has_call(nd_i3[node])) { return true; }
        return false;
    }
    if (k == ND_UNOP)        { return opt_has_call(nd_i2[node]); }
    if (k == ND_INDEX) {
        if (opt_has_call(nd_i2[node])) { return true; }
        if (opt_has_call(nd_i3[node])) { return true; }
        return false;
    }
    if (k == ND_FIELD_ACCESS) { return opt_has_call(nd_i2[node]); }
    if (k == ND_ARRAY_LIT)   { return opt_has_call(nd_i2[node]); }
    if (k == ND_STRUCT_LIT)  { return opt_has_call(nd_i2[node]); }
    if (k == ND_FIELD_INIT)  { return opt_has_call(nd_i2[node]); }
    if (k == ND_TO_GPU || k == ND_TO_CPU) { return opt_has_call(nd_i2[node]); }
    return false;
}

// Collect inline-able pure functions into the global table.
fn opt_collect_inlineables(int64 fns_list) -> int64 {
    mut fnode = fns_list;
    while (fnode != 0) {
        let def = nd_i2[fnode];
        let name = nd_sv[def];
        let params_list = nd_i2[def];
        let body_block  = nd_i4[def];
        // Skip main and recursive definitions (recursion is a user call we
        // can't safely inline) — just try to find the single-return body.
        if (body_block != 0) {
            let body_list = nd_i2[body_block];
            // Single statement: ND_CONS node whose head is ND_RETURN.
            if (body_list != 0 && nd_i3[body_list] == 0) {
                let stmt = nd_i2[body_list];
                if (nd_kind[stmt] == ND_RETURN) {
                    let expr = nd_i2[stmt];
                    if (expr != 0 && opt_has_call(expr) == false) {
                        inline_count = inline_count + 1;
                        if (inline_count < len(inline_names)) {
                            inline_names[inline_count]  = name;
                            inline_bodies[inline_count] = expr;
                            inline_params[inline_count] = params_list;
                        } else {
                            push(inline_names, name);
                            push(inline_bodies, expr);
                            push(inline_params, params_list);
                        }
                    }
                }
            }
        }
        fnode = nd_i3[fnode];
    }
    return 0;
}

fn inline_find(string name) -> int64 {
    mut i = 1;
    while (i <= inline_count) {
        if (str_eq(inline_names[i], name)) { return i; }
        i = i + 1;
    }
    return 0;
}

// Like opt_subst_var but substitutes an ND_IDENT named `var` with a *cloned*
// `rep` node (used to replace a parameter by its argument expression).
fn opt_subst_general(int64 node, string var, int64 rep) -> int64 {
    if (node == 0) { return 0; }
    let k = nd_kind[node];
    if (k == ND_IDENT && str_eq(nd_sv[node], var)) {
        return opt_clone_node(rep);
    }
    if (k == ND_BINOP) {
        nd_i2[node] = opt_subst_general(nd_i2[node], var, rep);
        nd_i3[node] = opt_subst_general(nd_i3[node], var, rep);
    } else if (k == ND_UNOP) {
        nd_i2[node] = opt_subst_general(nd_i2[node], var, rep);
    } else if (k == ND_INDEX) {
        nd_i2[node] = opt_subst_general(nd_i2[node], var, rep);
        nd_i3[node] = opt_subst_general(nd_i3[node], var, rep);
    } else if (k == ND_FIELD_ACCESS) {
        nd_i2[node] = opt_subst_general(nd_i2[node], var, rep);
    } else if (k == ND_ARRAY_LIT) {
        nd_i2[node] = opt_subst_general(nd_i2[node], var, rep);
    } else if (k == ND_STRUCT_LIT) {
        nd_i2[node] = opt_subst_general(nd_i2[node], var, rep);
    } else if (k == ND_FIELD_INIT) {
        nd_i2[node] = opt_subst_general(nd_i2[node], var, rep);
    } else if (k == ND_TO_GPU || k == ND_TO_CPU) {
        nd_i2[node] = opt_subst_general(nd_i2[node], var, rep);
    }
    return node;
}

// Try to inline `node` (an ND_CALL) if it names an inline-able function.
// Returns the rewritten expression (0 = leave the call alone).
fn opt_try_inline(int64 node) -> int64 {
    let callee = nd_sv[node];
    let ii = inline_find(callee);
    if (ii == 0) { return 0; }
    // Clone the function's pure body expression as our working copy.
    mut body = opt_clone_node(inline_bodies[ii]);
    // Walk the call's argument list and the parameter list in lockstep,
    // substituting each parameter by its (already-optimized) argument.
    mut an = nd_i2[node];    // args CONS list
    mut pn = inline_params[ii];
    while (pn != 0 && an != 0) {
        let pname = nd_sv[nd_i2[pn]];
        let arg = nd_i2[an];
        body = opt_subst_general(body, pname, arg);
        pn = nd_i3[pn];
        an = nd_i3[an];
    }
    // Optimize the fully-substituted body.
    return opt_expr(body);
}

// ─── Algebraic simplifications (one operand is a known literal) ───────────────

fn opt_alg(int64 op, int64 ln, int64 rn) -> int64 {
    // Returns a simplified node or 0 if no simplification applies.
    let lk  = nd_kind[ln];
    let rk  = nd_kind[rn];
    let lv  = nd_iv[ln];
    let rv  = nd_iv[rn];
    let lli = lk == ND_INT || lk == ND_BOOL;
    let rli = rk == ND_INT || rk == ND_BOOL;
    if (op == OP_ADD  && rli && rv == 0) { return ln; }
    if (op == OP_ADD  && lli && lv == 0) { return rn; }
    if (op == OP_SUB  && rli && rv == 0) { return ln; }
    if (op == OP_MUL  && rli && rv == 1) { return ln; }
    if (op == OP_MUL  && lli && lv == 1) { return rn; }
    if (op == OP_DIV  && rli && rv == 1) { return ln; }
    if (op == OP_BITOR  && rli && rv == 0) { return ln; }
    if (op == OP_BITOR  && lli && lv == 0) { return rn; }
    if (op == OP_BITXOR && rli && rv == 0) { return ln; }
    if (op == OP_BITXOR && lli && lv == 0) { return rn; }
    if (op == OP_SHL  && rli && rv == 0) { return ln; }
    if (op == OP_SHR  && rli && rv == 0) { return ln; }
    return 0;
}

// ─── Expression optimization ──────────────────────────────────────────────────

fn opt_cons_exprs(int64 list) -> int64 {
    mut c = list;
    while (c != 0) {
        nd_i2[c] = opt_expr(nd_i2[c]);
        c = nd_i3[c];
    }
    return 0;
}

fn opt_expr(int64 node) -> int64 {
    if (node == 0) { return 0; }
    let k = nd_kind[node];

    if (k == ND_IDENT && cp_active == 1) {
        // Replace references to provably-immutable locals with their literals.
        let sub = cp_pc_subst(node);
        return sub;
    }

    if (k == ND_INT || k == ND_FLOAT || k == ND_STR || k == ND_BOOL || k == ND_IDENT) {
        return node;
    }

    if (k == ND_BINOP) {
        let op = nd_iv[node];
        let ln = opt_expr(nd_i2[node]);
        let rn = opt_expr(nd_i3[node]);
        nd_i2[node] = ln;
        nd_i3[node] = rn;
        let lk = nd_kind[ln];
        let rk = nd_kind[rn];
        let lint = lk == ND_INT || lk == ND_BOOL;
        let rint = rk == ND_INT || rk == ND_BOOL;
        if (lint && rint) {
            let folded = opt_fold_int(op, nd_iv[ln], nd_iv[rn]);
            if (folded != 0) { return folded; }
        }
        let simp = opt_alg(op, ln, rn);
        if (simp != 0) { return simp; }

        // Float constant folding: both operands are float literals (or an
        // int literal promoted to float). Compute the result bit pattern at
        // compile time when the operation is a float arithmetic op.
        if (op == OP_FADD || op == OP_FSUB || op == OP_FMUL || op == OP_FDIV) {
            mut lb = -1;
            mut rb = -1;
            // Use bit-pattern helpers (return int64) so self-host type-checks.
            if (lk == ND_FLOAT) { lb = nd_iv[ln]; }
            else if (lint)      { lb = int_to_fbits(nd_iv[ln]); }
            if (rk == ND_FLOAT) { rb = nd_iv[rn]; }
            else if (rint)      { rb = int_to_fbits(nd_iv[rn]); }
            if (lb != -1 && rb != -1) {
                let folded = opt_fold_float(op, lb, rb);
                if (folded != 0) { return folded; }
            }
        }
        return node;
    }

    if (k == ND_UNOP) {
        let op = nd_iv[node];
        let cn = opt_expr(nd_i2[node]);
        nd_i2[node] = cn;
        let ck = nd_kind[cn];
        if (ck == ND_INT || ck == ND_BOOL) {
            let v = nd_iv[cn];
            if (op == OP_NEG)    { return new_node(ND_INT, "", 0 - v, 0, 0, 0); }
            if (op == OP_NOT)    { if (v == 0) { return new_node(ND_INT, "", 1, 0, 0, 0); } return new_node(ND_INT, "", 0, 0, 0, 0); }
            if (op == OP_BITNOT) { return new_node(ND_INT, "", ~v, 0, 0, 0); }
        }
        // Negating a float constant: flip the sign bit in the bit pattern.
        if (ck == ND_FLOAT && op == OP_NEG) {
            return new_node(ND_FLOAT, "", fsub_bits(0, nd_iv[cn]), 0, 0, 0);
        }
        return node;
    }

    if (k == ND_CALL || k == ND_ARRAY_LIT) {
        if (k == ND_CALL) {
            let callee = nd_sv[node];
            // Fold float builtins on constant float args.
            if (str_eq(callee, "sqrt") || str_eq(callee, "fabs") ||
                str_eq(callee, "floor") || str_eq(callee, "ceil")) {
                let folded = opt_fold_float_call(callee, nd_i2[node]);
                if (folded != 0) { return folded; }
            }
            // Optimize the arguments first, then attempt function inlining.
            opt_cons_exprs(nd_i2[node]);
            let inlined = opt_try_inline(node);
            if (inlined != 0) { return inlined; }
            return node;
        }
        opt_cons_exprs(nd_i2[node]);
        return node;
    }

    if (k == ND_INDEX) {
        nd_i2[node] = opt_expr(nd_i2[node]);
        nd_i3[node] = opt_expr(nd_i3[node]);
        return node;
    }

    if (k == ND_FIELD_ACCESS) {
        nd_i2[node] = opt_expr(nd_i2[node]);
        return node;
    }

    if (k == ND_METHOD_CALL) {
        nd_i2[node] = opt_expr(nd_i2[node]);
        opt_cons_exprs(nd_i3[node]);
        return node;
    }

    if (k == ND_STRUCT_LIT) {
        opt_cons_field_inits(nd_i2[node]);
        return node;
    }

    return node;
}

// ND_FIELD_INIT: sv=name, i2=value_expr
fn opt_cons_field_inits(int64 list) -> int64 {
    mut c = list;
    while (c != 0) {
        let fi = nd_i2[c];
        nd_i2[fi] = opt_expr(nd_i2[fi]);
        c = nd_i3[c];
    }
    return 0;
}

// ─── Scoped constant propagation (immutable `let` → literal) ────────────────
// Per-function subset of mem2reg: if a name is declared `let x = <literal>`
// and is never assigned to anywhere in the function (and not a `mut`), then
// every reference to x can be replaced by that literal. This is purely
// conservative — it only fires when the binding is provably constant across
// the whole function, so it can never change program semantics.

let CP_SZ = 256;            // max tracked constants per function
mut cp_pc_names = [""];     // name (1-based)
mut cp_pc_ivals = [0];
mut cp_pc_flags = [0];     // 0=none, 1=int, 2=float
mut cp_pc_count  = 0;
mut cp_active = 0;          // 1 while inside a function being const-propagated

fn cp_pc_reset() -> int64 {
    cp_pc_count = 0;
    return 0;
}

fn cp_pc_is_const(string name) -> int64 {
    mut i = 1;
    while (i <= cp_pc_count) {
        if (str_eq(cp_pc_names[i], name)) { return i; }
        i = i + 1;
    }
    return 0;
}

fn cp_pc_add_int(string name, int64 v) -> int64 {
    if (cp_pc_count >= CP_SZ) { return 0; }
    cp_pc_count = cp_pc_count + 1;
    if (cp_pc_count < len(cp_pc_names)) {
        cp_pc_names[cp_pc_count] = name;
        cp_pc_ivals[cp_pc_count] = v;
        cp_pc_flags[cp_pc_count] = 1;
    } else {
        push(cp_pc_names, name);
        push(cp_pc_ivals, v);
        push(cp_pc_flags, 1);
    }
    return 1;
}

fn cp_pc_add_float(string name, int64 bits) -> int64 {
    if (cp_pc_count >= CP_SZ) { return 0; }
    cp_pc_count = cp_pc_count + 1;
    if (cp_pc_count < len(cp_pc_names)) {
        cp_pc_names[cp_pc_count] = name;
        cp_pc_ivals[cp_pc_count] = bits;
        cp_pc_flags[cp_pc_count] = 2;
    } else {
        push(cp_pc_names, name);
        push(cp_pc_ivals, bits);
        push(cp_pc_flags, 2);
    }
    return 1;
}

fn cp_pc_drop(string name) -> int64 {
    mut i = 1;
    while (i <= cp_pc_count) {
        if (str_eq(cp_pc_names[i], name)) {
            cp_pc_flags[i] = 0;
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

// Scan a statement list for `let x = lit` (record) and assignments to x / `mut`
// (invalidate). This is the prepass: it must run before any propagation so that
// we only fold names that are constant across the *whole* function.
fn cp_pc_scan_stmt_list(int64 list, int64 in_fn) -> int64 {
    mut c = list;
    while (c != 0) {
        let s = nd_i2[c];
        cp_pc_scan_stmt(s, in_fn);
        c = nd_i3[c];
    }
    return 0;
}

fn cp_pc_scan_stmt(int64 node, int64 in_fn) -> int64 {
    if (node == 0) { return 0; }
    let k = nd_kind[node];

    if (k == ND_LET) {
        let name = nd_sv[node];
        let mut_flag = nd_iv[node];
        let init = nd_i3[node];
        if (mut_flag != 0) {
            cp_pc_drop(name);              // `mut` → not a compile-time const
        } else if (init != 0 && nd_kind[init] == ND_INT) {
            cp_pc_add_int(name, nd_iv[init]);
        } else if (init != 0 && nd_kind[init] == ND_FLOAT) {
            cp_pc_add_float(name, nd_iv[init]);
        } else {
            cp_pc_drop(name);              // non-literal init → not provably const
        }
    } else if (k == ND_ASSIGN) {
        let tgt = nd_i2[node];
        if (nd_kind[tgt] == ND_IDENT) {
            cp_pc_drop(nd_sv[tgt]);        // reassigned → can't propagate
        }
    } else if (k == ND_IF) {
        // Branches can reassign — invalidate names assigned in either branch.
        if (nd_i3[node] != 0) { cp_pc_scan_stmt_list(nd_i2[nd_i3[node]], in_fn); }
        if (nd_i4[node] != 0) { cp_pc_scan_stmt_list(nd_i2[nd_i4[node]], in_fn); }
    } else if (k == ND_WHILE) {
        if (nd_i3[node] != 0) { cp_pc_scan_stmt_list(nd_i2[nd_i3[node]], in_fn); }
    } else if (k == ND_FOR) {
        if (nd_i4[node] != 0) { cp_pc_scan_stmt_list(nd_i2[nd_i4[node]], in_fn); }
    } else if (k == ND_BLOCK) {
        cp_pc_scan_stmt_list(nd_i2[node], in_fn);
    }
    return 0;
}

// Replace ND_IDENT references to the current function's const table with their
// literal node. Returns a rewritten node, or the same node.
fn cp_pc_subst(int64 node) -> int64 {
    if (node == 0) { return 0; }
    let k = nd_kind[node];
    if (k == ND_IDENT) {
        let name = nd_sv[node];
        let idx = cp_pc_is_const(name);
        if (idx != 0) {
            if (cp_pc_flags[idx] == 1) {
                return new_node(ND_INT, "", cp_pc_ivals[idx], 0, 0, 0);
            } else if (cp_pc_flags[idx] == 2) {
                return new_node(ND_FLOAT, "", cp_pc_ivals[idx], 0, 0, 0);
            }
        }
        return node;
    }
    if (k == ND_BINOP) {
        nd_i2[node] = cp_pc_subst(nd_i2[node]);
        nd_i3[node] = cp_pc_subst(nd_i3[node]);
        return node;
    }
    if (k == ND_UNOP) {
        nd_i2[node] = cp_pc_subst(nd_i2[node]);
        return node;
    }
    if (k == ND_CALL) {
        nd_i2[node] = cp_pc_subst(nd_i2[node]);
        return node;
    }
    if (k == ND_INDEX) {
        nd_i2[node] = cp_pc_subst(nd_i2[node]);
        nd_i3[node] = cp_pc_subst(nd_i3[node]);
        return node;
    }
    if (k == ND_FIELD_ACCESS) {
        nd_i2[node] = cp_pc_subst(nd_i2[node]);
        return node;
    }
    if (k == ND_METHOD_CALL) {
        nd_i2[node] = cp_pc_subst(nd_i2[node]);
        nd_i3[node] = cp_pc_subst(nd_i3[node]);
        return node;
    }
    if (k == ND_ARRAY_LIT) {
        nd_i2[node] = cp_pc_subst(nd_i2[node]);
        return node;
    }
    if (k == ND_STRUCT_LIT) {
        nd_i2[node] = cp_pc_subst(nd_i2[node]);
        return node;
    }
    if (k == ND_FIELD_INIT) {
        nd_i2[node] = cp_pc_subst(nd_i2[node]);
        return node;
    }
    if (k == ND_TO_GPU || k == ND_TO_CPU) {
        nd_i2[node] = cp_pc_subst(nd_i2[node]);
        return node;
    }
    return node;
}

// ─── Statement optimization ───────────────────────────────────────────────────

fn opt_stmt(int64 node) -> int64 {
    let k = nd_kind[node];

    if (k == ND_LET) {
        if (nd_i3[node] != 0) { nd_i3[node] = opt_expr(nd_i3[node]); }
        return node;
    }

    if (k == ND_ASSIGN) {
        nd_i2[node] = opt_expr(nd_i2[node]);
        nd_i3[node] = opt_expr(nd_i3[node]);
        return node;
    }

    if (k == ND_EXPR_STMT) {
        nd_i2[node] = opt_expr(nd_i2[node]);
        return node;
    }

    if (k == ND_RETURN) {
        if (nd_i2[node] != 0) { nd_i2[node] = opt_expr(nd_i2[node]); }
        return node;
    }

    if (k == ND_IF) {
        let cond = opt_expr(nd_i2[node]);
        nd_i2[node] = cond;
        let then_block = nd_i3[node];
        let else_block = nd_i4[node];
        if (then_block != 0) { opt_stmts(nd_i2[then_block]); }
        if (else_block != 0) { opt_stmts(nd_i2[else_block]); }
        // Dead branch elimination on constant condition
        let ck = nd_kind[cond];
        if (ck == ND_INT || ck == ND_BOOL) {
            nd_kind[node] = ND_BLOCK;
            if (nd_iv[cond] != 0) {
                nd_i2[node] = nd_i2[then_block];
            } else {
                if (else_block != 0) {
                    nd_i2[node] = nd_i2[else_block];
                } else {
                    nd_i2[node] = 0;
                }
            }
        }
        return node;
    }

    if (k == ND_WHILE) {
        nd_i2[node] = opt_expr(nd_i2[node]);
        let body = nd_i3[node];
        if (body != 0) { opt_stmts(nd_i2[body]); }
        return node;
    }

    if (k == ND_FOR) {
        // Only unroll when both bounds are compile-time integer constants.
        let var = nd_sv[node];
        let start_nd = opt_expr(nd_i2[node]);
        let end_nd   = opt_expr(nd_i3[node]);
        nd_i2[node] = start_nd;
        nd_i3[node] = end_nd;
        let body = nd_i4[node];
        mut body_list = 0;
        if (body != 0) { body_list = nd_i2[body]; }

        mut is_small = 0;
        if (start_nd != 0 && end_nd != 0 &&
            nd_kind[start_nd] == ND_INT && nd_kind[end_nd] == ND_INT) {
            let lo = nd_iv[start_nd];
            let hi = nd_iv[end_nd];
            if (hi >= lo && (hi - lo) <= 8) { is_small = 1; }
        }

        if (is_small == 1 && opt_stmts_has_control(body_list) == false) {
            let lo = nd_iv[start_nd];
            let hi = nd_iv[end_nd];
            let trip = hi - lo;
            // Flatten N iterations: for each it, clone the body (deep) then
            // substitute the loop var with its literal index value.
            mut head = 0;      // resulting statement list (ND_CONS chain)
            mut tail = 0;
            mut it = 0;
            while (it < trip) {
                let inst_idx = lo + it;
                // Clone whole CONS list (statements).
                let cloned_list = opt_clone_node(body_list);
                // Substitute var→index in the cloned statements.
                opt_subst_var(cloned_list, var, inst_idx);
                // Optimize the cloned iteration, then append each statement.
                mut cc2 = cloned_list;
                while (cc2 != 0) {
                    let stmt = opt_stmt(nd_i2[cc2]);
                    nd_i2[cc2] = stmt;
                    // append to output list
                    let nc = new_node(ND_CONS, "", 0, stmt, 0, 0);
                    if (head == 0) { head = nc; }
                    else           { nd_i3[tail] = nc; }
                    tail = nc;
                    cc2 = nd_i3[cc2];
                }
                it = it + 1;
            }
            // If body was empty or trip<=0, we produce an empty block.
            if (head == 0) { head = 0; }
            // Replace the for-loop node with an inlined ND_BLOCK.
            nd_kind[node] = ND_BLOCK;
            nd_i2[node]   = head;
            nd_i3[node]   = 0;
            nd_i4[node]   = 0;
            return node;
        }

        let body2 = nd_i4[node];
        if (body2 != 0) { opt_stmts(nd_i2[body2]); }
        return node;
    }

    if (k == ND_BLOCK) {
        opt_stmts(nd_i2[node]);
        return node;
    }

    return node;
}

fn opt_stmts(int64 list) -> int64 {
    mut cons = list;
    while (cons != 0) {
        nd_i2[cons] = opt_stmt(nd_i2[cons]);
        // Truncate dead code after a return statement
        if (nd_kind[nd_i2[cons]] == ND_RETURN) {
            nd_i3[cons] = 0;
            return list;
        }
        cons = nd_i3[cons];
    }
    return list;
}

// ─── Top-level entry point ────────────────────────────────────────────────────

fn opt_fn(int64 fn_node) -> int64 {
    // Scoped const propagation: pre-scan to collect `let x = const` bindings
    // that are never reassigned anywhere in this function, then substitute them.
    cp_pc_reset();
    let body_block = nd_i4[fn_node];
    if (body_block != 0) {
        cp_pc_scan_stmt_list(nd_i2[body_block], 1);
    }
    cp_active = 1;
    if (body_block != 0) { opt_stmts(nd_i2[body_block]); }
    cp_active = 0;
    return 0;
}

fn opt_program(int64 fns_list, int64 top_list) -> int64 {
    // Reset inline table (a fresh compile starts clean). Arrays are
    // pre-initialized singletons and use 1-based indexing, so don't arr_reset.
    inline_count = 0;
    // Collect leaf pure functions that are safe to inline.
    opt_collect_inlineables(fns_list);
    // Optimize each function body.
    mut c = fns_list;
    while (c != 0) {
        opt_fn(nd_i2[c]);
        c = nd_i3[c];
    }
    // Optimize top-level statements.
    opt_stmts(top_list);
    return 0;
}
