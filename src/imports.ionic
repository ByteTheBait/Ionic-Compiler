// ── Import resolution ────────────────────────────────────────────────────────
import "lexer/tokens.ionic";   // CH_* character constants

// Resolves `import` statements at compile time by loading sources from one
// of three locations (first match wins):
//
//   1. ./.ionic/packages/<dotted-as-slash>.ionic   (project-local packages)
//   2. $HOME/.ionic/packages/<dotted-as-slash>.ionic  (user-central packages)
//      — falls back to $USERPROFILE for Windows compat
//   3. lib/<dotted-as-slash>.ionic   (built-in stdlib, when first segment
//      is "std" — the only legitimate path into the bundled library)
//
// Selective imports `import std.X.{a,b};` are parsed but not yet filtered:
// the whole module is included.
//
// Each loaded module is recursively expanded (its own imports are resolved
// before it) and modules are deduped so cycles are tolerated.
// ─────────────────────────────────────────────────────────────────────────────

// Accumulated source fragments (dependency order). [0] is a sentinel.
mut g_parts    = [""];
mut g_part_cnt = 0;

// Modules already loaded, keyed by dotted path. [0] sentinel.
mut g_mod_paths = [""];
mut g_mod_count = 0;

fn imp_mod_loaded(string path) -> int64 {
    mut i = 1;
    while (i <= g_mod_count) {
        if (str_eq(g_mod_paths[i], path)) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn imp_mod_mark(string path) -> int64 {
    g_mod_count = g_mod_count + 1;
    if (g_mod_count < len(g_mod_paths)) { g_mod_paths[g_mod_count] = path; }
    else { push(g_mod_paths, path); }
    return 0;
}

// Does `src` contain `prefix` verbatim at byte offset `start`?
fn imp_starts_at(string src, string prefix, int64 start) -> int64 {
    let plen = str_len(prefix);
    if (str_len(src) < start + plen) { return 0; }
    mut i = 0;
    while (i < plen) {
        if (str_index(src, start + i) != str_index(prefix, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Return the byte offset just past an identifier run [A-Za-z0-9_] starting at pos.
fn imp_span_ident(string s, int64 pos) -> int64 {
    let n = str_len(s);
    mut i = pos;
    while (i < n) {
        let c = str_index(s, i);
        mut isc = 0;
        if (c >= 48 && c <= 57)  { isc = 1; }
        if (c >= 65 && c <= 90)  { isc = 1; }
        if (c >= 97 && c <= 122) { isc = 1; }
        if (c == 95)             { isc = 1; }
        if (isc == 0) { return i; }
        i = i + 1;
    }
    return i;
}

// Return the byte offset just past leading spaces/tabs starting at pos.
fn imp_skip_space(string s, int64 pos) -> int64 {
    let n = str_len(s);
    mut i = pos;
    while (i < n) {
        let c = str_index(s, i);
        if (c != 32 && c != 9) { return i; }
        i = i + 1;
    }
    return i;
}

// Return the byte offset of the next newline starting at pos (or end).
fn imp_next_nl(string s, int64 pos) -> int64 {
    let n = str_len(s);
    mut i = pos;
    while (i < n) {
        if (str_index(s, i) == 10) { return i; }   // CH_NL = 10
        i = i + 1;
    }
    return n;
}

// Convert a dotted module path to slash form.
//   "std"           -> "std"
//   "std.math"      -> "std/math"
//   "std.data.csv"  -> "std/data/csv"
fn imp_path_slash(string dotted) -> string {
    let n = str_len(dotted);
    if (n == 0) { return ""; }
    mut out = "";
    mut i = 0;
    while (i < n) {
        let c = str_index(dotted, i);
        if (c == 46) { out = str_concat(out, "/"); }   // CH_DOT = 46
        else {
            // Build a 1-char literal for each allowed ASCII identifier byte.
            // Valid path-segment chars are [A-Za-z0-9_] — encode each one.
            mut emit = "";
            if (c == 95) { emit = "_"; }
            if (c >= 48 && c <= 57) {
                if (c == 48) { emit = "0"; }
                if (c == 49) { emit = "1"; }
                if (c == 50) { emit = "2"; }
                if (c == 51) { emit = "3"; }
                if (c == 52) { emit = "4"; }
                if (c == 53) { emit = "5"; }
                if (c == 54) { emit = "6"; }
                if (c == 55) { emit = "7"; }
                if (c == 56) { emit = "8"; }
                if (c == 57) { emit = "9"; }
            }
            if (c >= 65 && c <= 90) {
                if (c == 65) { emit = "A"; }
                if (c == 66) { emit = "B"; }
                if (c == 67) { emit = "C"; }
                if (c == 68) { emit = "D"; }
                if (c == 69) { emit = "E"; }
                if (c == 70) { emit = "F"; }
                if (c == 71) { emit = "G"; }
                if (c == 72) { emit = "H"; }
                if (c == 73) { emit = "I"; }
                if (c == 74) { emit = "J"; }
                if (c == 75) { emit = "K"; }
                if (c == 76) { emit = "L"; }
                if (c == 77) { emit = "M"; }
                if (c == 78) { emit = "N"; }
                if (c == 79) { emit = "O"; }
                if (c == 80) { emit = "P"; }
                if (c == 81) { emit = "Q"; }
                if (c == 82) { emit = "R"; }
                if (c == 83) { emit = "S"; }
                if (c == 84) { emit = "T"; }
                if (c == 85) { emit = "U"; }
                if (c == 86) { emit = "V"; }
                if (c == 87) { emit = "W"; }
                if (c == 88) { emit = "X"; }
                if (c == 89) { emit = "Y"; }
                if (c == 90) { emit = "Z"; }
            }
            if (c >= 97 && c <= 122) {
                if (c == 97)  { emit = "a"; }
                if (c == 98)  { emit = "b"; }
                if (c == 99)  { emit = "c"; }
                if (c == 100) { emit = "d"; }
                if (c == 101) { emit = "e"; }
                if (c == 102) { emit = "f"; }
                if (c == 103) { emit = "g"; }
                if (c == 104) { emit = "h"; }
                if (c == 105) { emit = "i"; }
                if (c == 106) { emit = "j"; }
                if (c == 107) { emit = "k"; }
                if (c == 108) { emit = "l"; }
                if (c == 109) { emit = "m"; }
                if (c == 110) { emit = "n"; }
                if (c == 111) { emit = "o"; }
                if (c == 112) { emit = "p"; }
                if (c == 113) { emit = "q"; }
                if (c == 114) { emit = "r"; }
                if (c == 115) { emit = "s"; }
                if (c == 116) { emit = "t"; }
                if (c == 117) { emit = "u"; }
                if (c == 118) { emit = "v"; }
                if (c == 119) { emit = "w"; }
                if (c == 120) { emit = "x"; }
                if (c == 121) { emit = "y"; }
                if (c == 122) { emit = "z"; }
            }
            out = str_concat(out, emit);
        }
        i = i + 1;
    }
    return out;
}

// Return the first segment of a dotted module path.
//   "std.math"      -> "std"
//   "std.data.csv"  -> "std"
//   "math"          -> "math"
fn imp_first_seg(string dotted) -> string {
    let n = str_len(dotted);
    mut i = 0;
    while (i < n) {
        if (str_index(dotted, i) == 46) { return str_slice(dotted, 0, i); }   // CH_DOT
        i = i + 1;
    }
    return dotted;
}

// Read a file's contents if it exists, else return "".
fn imp_try_read(string path) -> string {
    return file_read(path);
}

// ── Relative-path imports ────────────────────────────────────────────────────
// `import "codegen/native.ionic";` (string literal) resolves against the
// directory of the file containing the import, so a tree of sources can
// reference siblings with real paths instead of the flat dotted stdlib form.
// g_imp_dir is the directory of the file currently being expanded; it is
// saved/restored around each recursive expansion so nested imports resolve
// relative to their own file.

mut g_imp_dir = ".";

// Directory portion of a path ("a/b/c.ionic" -> "a/b"; "c.ionic" -> ".").
fn imp_dir_of(string path) -> string {
    let n = str_len(path);
    mut last = -1;
    mut i = 0;
    while (i < n) {
        if (str_index(path, i) == CH_SLASH) { last = i; }
        i = i + 1;
    }
    if (last < 0) { return "."; }
    if (last == 0) { return "/"; }
    return str_slice(path, 0, last);
}

// Join a directory and a relative path. An absolute rel passes through.
fn imp_join(string dir, string rel) -> string {
    if (str_len(rel) > 0 && str_index(rel, 0) == CH_SLASH) { return rel; }
    if (str_eq(dir, "") || str_eq(dir, ".")) { return rel; }
    return str_concat(dir, str_concat("/", rel));
}

// Normalize a path: collapse "." and ".." segments so that dedup keys are
// canonical ("src/parser/../lexer/tokens.ionic" -> "src/lexer/tokens.ionic").
// This keeps a diamond import from loading the same file twice under two keys.
fn imp_norm(string path) -> string {
    let n = str_len(path);
    // Absolute? remember a leading '/'.
    mut abs = 0;
    if (n > 0 && str_index(path, 0) == CH_SLASH) { abs = 1; }
    mut out = "";       // accumulated canonical segments (no leading slash)
    mut i = 0;
    while (i < n) {
        // read one segment [i, j)
        let j0 = i;
        mut j = i;
        while (j < n && str_index(path, j) != CH_SLASH) { j = j + 1; }
        let seg = str_slice(path, j0, j);
        if (str_eq(seg, "") || str_eq(seg, ".")) {
            // skip empty + "."
        } else if (str_eq(seg, "..")) {
            out = imp_drop_last_seg(out);
        } else {
            if (str_eq(out, "")) { out = seg; }
            else { out = str_concat(out, str_concat("/", seg)); }
        }
        i = j + 1;
    }
    if (abs == 1) { return str_concat("/", out); }
    if (str_eq(out, "")) { return "."; }
    return out;
}

// Remove the final "seg" or "a/seg" component from a segment list.
fn imp_drop_last_seg(string segs) -> string {
    let n = str_len(segs);
    mut last = -1;
    mut i = 0;
    while (i < n) {
        if (str_index(segs, i) == CH_SLASH) { last = i; }
        i = i + 1;
    }
    if (last < 0) { return ""; }
    return str_slice(segs, 0, last);
}

// Resolve + expand a path-style (literal) import, relative to g_imp_dir.
fn imp_resolve_rel(string rel) -> int64 {
    let full = imp_norm(imp_join(g_imp_dir, rel));
    if (imp_mod_loaded(full)) { return 0; }
    imp_mod_mark(full);
    let content = imp_try_read(full);
    if (str_len(content) == 0) {
        println(str_concat("ionic: cannot resolve import '",
                str_concat(rel, "'")));
        println(str_concat("  tried: ", full));
        exit(1);
    }
    let saved = g_imp_dir;
    g_imp_dir = imp_dir_of(full);
    imp_expand(content);
    g_imp_dir = saved;
    return 0;
}

// Resolve a dotted module path against the three layers.  Loads + expands
// the first match; prints a diagnostic + aborts via exit() if nothing matches.
fn imp_resolve(string modpath) -> int64 {
    if (imp_mod_loaded(modpath)) { return 0; }
    imp_mod_mark(modpath);

    let slash = imp_path_slash(modpath);
    let home  = getenv("HOME");
    let prof  = getenv("USERPROFILE");

    // Layer 1: project-local
    let p_local = str_concat("./.ionic/packages/", str_concat(slash, ".ionic"));
    let c_local = imp_try_read(p_local);
    if (str_len(c_local) > 0) {
        imp_expand(c_local);
        return 0;
    }

    // Layer 2: user-central
    mut home_root = "";
    if (str_len(home) > 0)        { home_root = home; }
    else if (str_len(prof) > 0)   { home_root = prof; }
    if (str_len(home_root) > 0) {
        let p_user = str_concat(str_concat(home_root, "/.ionic/packages/"),
                                str_concat(slash, ".ionic"));
        let c_user = imp_try_read(p_user);
        if (str_len(c_user) > 0) {
            imp_expand(c_user);
            return 0;
        }
    }

    // Layer 3: built-in stdlib (only when first segment is "std")
    let first = imp_first_seg(modpath);
    // Compare first 3 bytes to "std" using numeric codes: s=115 t=116 d=100
    mut is_std = 0;
    if (str_len(first) == 3) {
        if (str_index(first, 0) == 115 &&
            str_index(first, 1) == 116 &&
            str_index(first, 2) == 100) {
            is_std = 1;
        }
    }
    if (is_std == 1) {
        let p_std = str_concat("lib/", str_concat(slash, ".ionic"));
        let c_std = imp_try_read(p_std);
        if (str_len(c_std) > 0) {
            imp_expand(c_std);
            return 0;
        }
    }

    // Nothing matched — list what we tried and exit non-zero.
    println(str_concat("ionic: cannot resolve import '",
            str_concat(modpath, "'")));
    println(str_concat("  tried: ", p_local));
    if (str_len(home_root) > 0) {
        let p_user2 = str_concat(str_concat(home_root, "/.ionic/packages/"),
                                 str_concat(slash, ".ionic"));
        println(str_concat("  tried: ", p_user2));
    }
    if (is_std == 1) {
        let p_std2 = str_concat("lib/", str_concat(slash, ".ionic"));
        println(str_concat("  tried: ", p_std2));
    }
    exit(1);
    return 0;
}

// Append one source fragment to the accumulated output (if non-empty).
fn imp_emit(string frag) -> int64 {
    if (str_len(frag) > 0) {
        g_part_cnt = g_part_cnt + 1;
        if (g_part_cnt < len(g_parts)) { g_parts[g_part_cnt] = frag; }
        else { push(g_parts, frag); }
    }
    return 0;
}

// Expand source, splicing in imports and stripping import lines.
fn imp_expand(string src) -> int64 {
    let n = str_len(src);
    mut acc = "";
    mut pos = 0;
    while (pos < n) {
        let nl = imp_next_nl(src, pos);
        let s0 = imp_skip_space(src, pos);
        mut is_imp = 0;
        if (s0 < nl) {
            if (imp_starts_at(src, "import", s0)) {
                let after = s0 + 6;
                if (after < n) {
                    let c = str_index(src, after);
                    if (c == 32 || c == 9) { is_imp = 1; }
                }
            }
        }
        if (is_imp == 1) {
            mut p = imp_skip_space(src, s0 + 6);
            // Path-style import: `import "codegen/native.ionic";` — resolved
            // relative to the importing file's directory.
            if (p < n && str_index(src, p) == CH_QUOTE) {
                let qstart = p + 1;
                mut q = qstart;
                while (q < n && str_index(src, q) != CH_QUOTE) { q = q + 1; }
                let rel = str_slice(src, qstart, q);
                imp_resolve_rel(rel);
            } else {
                let e1 = imp_span_ident(src, p);
                mut modpath = str_slice(src, p, e1);
                p = e1;
                mut done_p = 0;
                while (done_p == 0 && p < nl) {
                    if (p + 1 < n && str_index(src, p) == 46) {   // CH_DOT
                        let estart = p + 1;
                        let eend = imp_span_ident(src, estart);
                        if (eend > estart) {
                            modpath = str_concat(modpath, str_concat(".", str_slice(src, estart, eend)));
                            p = eend;
                        } else {
                            done_p = 1;
                        }
                    } else {
                        done_p = 1;
                    }
                }
                imp_resolve(modpath);
            }
        } else {
            acc = str_concat(acc, str_concat(str_slice(src, pos, nl), "\n"));
        }
        pos = nl + 1;
    }
    imp_emit(acc);
    return 0;
}

// Reset import resolver state for a fresh invocation.
fn imp_reset() -> int64 {
    g_parts    = [""];
    g_part_cnt = 0;
    g_mod_paths = [""];
    g_mod_count = 0;
    g_imp_dir = ".";
    return 0;
}
